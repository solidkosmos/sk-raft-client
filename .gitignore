# Design files (bitstream and the files for fault injection)
*.bit
*.ebd
*.ebc
*.ll
*.msd
*.rbd

# Design files extracted from design_examples.zip or written by create_project.tcl
get_started/hw/design_examples/*/

# Vivado projects that create_project.tcl creates
