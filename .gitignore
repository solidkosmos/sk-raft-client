.Xil/
*.jou
*.log
vivado_pid*.str
vivado_pid*.zip
dfx_runtime.txt
webtalk*/
usage_statistics_webtalk.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
api/python/build/
api/python/dist/
*.egg-info/

# Editors
.idea/
.vscode/
*.ipynb_checkpoints
*.virtual_documents
