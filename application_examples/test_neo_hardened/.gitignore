# create_project.tcl and Vivado make the files below again when necessary.
# Git tracks only the sources, the project script, the constraints and the
# documents. Refer to "Build and run the example" in README.md.

# The Vivado project that create_project.tcl makes (default project name
# "test_neo"): .xpr, caches, runs and simulation files. Vivado makes all of
# it again from hw/ and create_project.tcl.
/test_neo/

# The same project files, if you give create_project.tcl a different
# project name (-tclargs [project_name] [project_dir])
*.xpr
*.cache/
*.hw/
*.ioplanning/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/sources_1/bd/*/hw_handoff/
*.srcs/sources_1/bd/*/hw/
*.srcs/sources_1/bd/*/ip/
*.srcs/sources_1/bd/*/synth/
*.srcs/sources_1/bd/*/sim/
*.gen/
.Xil/

# PlanAhead/floorplanning pblock visualization scripts and DFX scratch state --
# both auto-regenerated by Vivado, not meant to be hand-edited or reviewed
hd_visual/
dfx_runtime.txt

# Vivado logs/journals and misc scratch
vivado*.log
vivado*.jou
vivado*.str
vivado_pid*.str
.vivado.log
webtalk*.log
webtalk*.jou
*.backup.log
*.backup.jou
usage_statistics_webtalk.html

# Results of run_injection.py (CSV files and raw UART data)
neorv_fi_example/injection_results/

# Editor/OS cruft
*.bak
*~
.DS_Store
Thumbs.db
