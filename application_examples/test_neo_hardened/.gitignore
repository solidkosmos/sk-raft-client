# Everything under here is regenerated by `source create_project.tcl` in
# Vivado -- only sources, the project script, constraints, and docs are
# meant to be tracked. See README.md's Design Flow section.

# The full generated Vivado project directory (created the first time
# create_project.tcl is run -- default project name is "test_neo", see
# _xil_proj_name_ in create_project.tcl). Entirely disposable: .xpr, caches,
# runs, sim, IP output products (including clk_wiz_0), everything -- all of
# it is regenerated from hw/ + create_project.tcl on demand.
/test_neo/

# Defensive fallback in case create_project.tcl is ever run with a custom
# --project_name (the folder name would then differ from "test_neo" above)
*.xpr
*.cache/
*.hw/
*.ioplanning/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/sources_1/bd/*/hw_handoff/
*.srcs/sources_1/bd/*/hw/
*.srcs/sources_1/bd/*/ip/
*.srcs/sources_1/bd/*/synth/
*.srcs/sources_1/bd/*/sim/
*.gen/
.Xil/

# PlanAhead/floorplanning pblock visualization scripts and DFX scratch state --
# both auto-regenerated by Vivado, not meant to be hand-edited or reviewed
hd_visual/
dfx_runtime.txt

# Vivado logs/journals and misc scratch
vivado*.log
vivado*.jou
vivado*.str
vivado_pid*.str
.vivado.log
webtalk*.log
webtalk*.jou
*.backup.log
*.backup.jou
usage_statistics_webtalk.html

# Results of run_injection.py (CSV files and raw UART data)
neorv_fi_example/injection_results/

# Editor/OS cruft
*.bak
*~
.DS_Store
Thumbs.db
